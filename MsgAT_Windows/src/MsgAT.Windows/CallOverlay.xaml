<UserControl x:Class="MsgAT.Windows.CallOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" SizeChanged="Overlay_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="CallAction" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="64"/><Setter Property="Height" Value="64"/>
            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16"/>
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                <Viewbox Width="28" Height="28"><Path Data="{Binding}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"/></Viewbox>
            </DataTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CallMute" TargetType="Button" BasedOn="{StaticResource CallAction}">
            <Setter Property="Content" Value="{StaticResource MicrophoneIcon}"/>
            <Setter Property="ToolTip" Value="{Binding MuteText}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding MuteText}"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsMuted}" Value="True">
                <Setter Property="Content" Value="{StaticResource MutedMicrophoneIcon}"/>
                <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="Black"/>
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="CallSpeaker" TargetType="Button" BasedOn="{StaticResource CallAction}">
            <Setter Property="Content" Value="M 2,7 L 6,7 L 11,2 L 11,18 L 6,13 L 2,13 Z M 14,5 L 16,7 L 16,13 L 14,15 L 14,13 L 15,11 L 15,9 L 14,7 Z M 17,2 L 20,6 L 21,10 L 20,14 L 17,18 L 17,15 L 19,12 L 19,8 L 17,5 Z"/>
            <Setter Property="ToolTip" Value="{Binding SpeakerText}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding SpeakerText}"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsSpeakerOn}" Value="True">
                <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="Black"/>
            </DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="OverlayRoot">
        <Grid x:Name="FullPanel" Background="{StaticResource WindowBrush}" RenderTransformOrigin="0.5,0.5">

            <StackPanel x:Name="PeerDetails" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,100,0,0">
                <Grid Width="120" Height="120">
                    <Ellipse Fill="#FF444444"/>
                    <TextBlock Text="{Binding PeerInitial}" FontSize="40" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse Fill="{Binding PeerAvatarPath, Converter={StaticResource AvatarConverter}}"/>
                </Grid>
                <TextBlock Text="{Binding PeerAlias}" FontSize="28" Foreground="White" HorizontalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" Margin="0,24,0,8"/>
                <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="Foreground" Value="LightGray"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsIncoming}" Value="True"><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="Gray"/></DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Ended"><Setter Property="Foreground" Value="Red"/></DataTrigger>
                        </Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <Button x:Name="MinimizeButton" Content="{StaticResource MinimizeIcon}" Style="{StaticResource CallAction}" Width="48" Height="48" Padding="8" Background="Transparent"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="Minimize_Click"/>
            <StackPanel x:Name="Quality" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16">
                <Ellipse Width="8" Height="8" Fill="{Binding QualityBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding RttText}" FontSize="12" Foreground="White" Margin="4,0,0,0"/>
            </StackPanel>
            <UniformGrid x:Name="IncomingActions" Rows="1" Columns="2" VerticalAlignment="Bottom" Margin="0,0,0,60">
                <StackPanel HorizontalAlignment="Center"><Button Content="{StaticResource HangUpIcon}" Style="{StaticResource CallAction}" Width="72" Height="72" Padding="18" Background="Red" ToolTip="Reject" AutomationProperties.Name="Reject" Click="Reject_Click"/>
                    <TextBlock Text="Decline" FontSize="16" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
                <StackPanel HorizontalAlignment="Center"><Button Content="{StaticResource CallIcon}" Style="{StaticResource CallAction}" Width="72" Height="72" Padding="18" Background="#FF4CAF50" ToolTip="Accept" AutomationProperties.Name="Accept" Click="Accept_Click"/>
                    <TextBlock Text="Accept" FontSize="16" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
            </UniformGrid>
            <StackPanel x:Name="ActiveActions" VerticalAlignment="Bottom" Margin="0,0,0,60">
                <UniformGrid Rows="1" Columns="2"><Button Style="{StaticResource CallMute}" HorizontalAlignment="Center" Click="Mute_Click"/>
                    <Button Style="{StaticResource CallSpeaker}" HorizontalAlignment="Center" Click="Speaker_Click"/></UniformGrid>
                <Button Content="{StaticResource HangUpIcon}" Style="{StaticResource CallAction}" Width="72" Height="72" Padding="18" Background="Red" HorizontalAlignment="Center" Margin="0,40,0,0" ToolTip="End Call" AutomationProperties.Name="End Call" Click="End_Click"/>
            </StackPanel>
        </Grid>
        <Border x:Name="CompactPanel" Visibility="Collapsed" Width="80" Height="80" Background="{StaticResource PanelBrush}" CornerRadius="16" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonDown="Compact_MouseLeftButtonDown" MouseMove="Compact_MouseMove" MouseLeftButtonUp="Compact_MouseLeftButtonUp">
            <Border.RenderTransform><TransformGroup><TranslateTransform x:Name="CompactPosition"/></TransformGroup></Border.RenderTransform>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="40" Height="40"><Ellipse Fill="#FF444444"/><TextBlock Text="{Binding PeerInitial}" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse Fill="{Binding PeerAvatarPath, Converter={StaticResource AvatarConverter}}"/></Grid>
                <TextBlock Text="{Binding DurationText}" FontSize="12" Foreground="Lime" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
