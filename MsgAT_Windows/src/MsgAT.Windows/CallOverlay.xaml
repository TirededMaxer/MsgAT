<UserControl x:Class="MsgAT.Windows.CallOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" SizeChanged="Overlay_SizeChanged"
        Focusable="True" KeyboardNavigation.TabNavigation="Cycle">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CallAcceptBrush" Color="#FF126741" />
        <SolidColorBrush x:Key="CallDeclineBrush" Color="#FFAD3543" />
        <Style x:Key="CallAction" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="56"/><Setter Property="Height" Value="56"/>
            <Setter Property="Background" Value="{DynamicResource MessagingChromeBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                <Viewbox Width="28" Height="28"><Path Data="{Binding}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"/></Viewbox>
            </DataTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CallAnswer" TargetType="Button" BasedOn="{StaticResource CallAction}">
            <Setter Property="Content" Value="{StaticResource CallIcon}" />
            <Setter Property="Background" Value="{StaticResource CallAcceptBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVideoCall}" Value="True">
                    <Setter Property="Content" Value="{StaticResource VideoCallIcon}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CallTerminal" TargetType="Button" BasedOn="{StaticResource CallAction}">
            <Setter Property="Content" Value="{StaticResource HangUpIcon}" />
            <Setter Property="Background" Value="{StaticResource CallDeclineBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="CallMute" TargetType="Button" BasedOn="{StaticResource CallAction}">
            <Setter Property="Content" Value="{StaticResource MicrophoneIcon}"/>
            <Setter Property="ToolTip" Value="{Binding MuteText}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding MuteText}"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsMuted}" Value="True">
                <Setter Property="Content" Value="{StaticResource MutedMicrophoneIcon}"/>
                <Setter Property="Background" Value="{DynamicResource MessagingSelectionBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource MessagingSelectionMarkBrush}"/>
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="CallOutputShortcut" TargetType="Button" BasedOn="{StaticResource CallAction}">
            <Setter Property="IsEnabled" Value="{Binding CanChooseAudioOutput}"/>
            <Setter Property="Content" Value="M 2,7 L 6,7 L 11,2 L 11,18 L 6,13 L 2,13 Z M 14,5 L 16,7 L 16,13 L 14,15 L 14,13 L 15,11 L 15,9 L 14,7 Z M 17,2 L 20,6 L 21,10 L 20,14 L 17,18 L 17,15 L 19,12 L 19,8 L 17,5 Z"/>
            <Setter Property="ToolTip" Value="{Binding OutputShortcutText}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding OutputShortcutText}"/>
            <Style.Triggers><DataTrigger Binding="{Binding UsesCommunicationsOutput}" Value="True">
                <Setter Property="Background" Value="{DynamicResource MessagingSelectionBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource MessagingSelectionMarkBrush}"/>
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="CallCamera" TargetType="Button" BasedOn="{StaticResource CallAction}">
            <Setter Property="Content" Value="{StaticResource VideoCameraOffIcon}"/>
            <Setter Property="ToolTip" Value="{Binding CameraText}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding CameraText}"/>
            <Style.Triggers><DataTrigger Binding="{Binding CameraEnabled}" Value="True">
                <Setter Property="Content" Value="{StaticResource VideoCallIcon}"/>
                <Setter Property="Background" Value="{DynamicResource MessagingSelectionBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource MessagingSelectionMarkBrush}"/>
            </DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="OverlayRoot">
        <Grid x:Name="FullPanel" Background="{DynamicResource MessagingTimelineBrush}" RenderTransformOrigin="0.5,0.5">
            <Grid x:Name="VideoHost" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" />
            <Grid x:Name="RemoteVideoStatus" Visibility="Collapsed" IsHitTestVisible="False" Margin="28,63,28,78">
                <TextBlock Text="{DynamicResource UiCallWaitingVideo}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FFD5D8DE" />
                            <Setter Property="FontSize" Value="15" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRemoteVideo}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <StackPanel x:Name="VideoHeader" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="60,10">
                <TextBlock Text="{Binding PeerAlias}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="PeerDetails" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,76,12,0">
                <Grid x:Name="PeerAvatar" Width="104" Height="104">
                    <Ellipse Fill="{DynamicResource MessagingSelectionBrush}"/>
                    <TextBlock Text="{Binding PeerInitial}" FontSize="28" Foreground="{DynamicResource MessagingSelectionMarkBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse Fill="{Binding PeerAvatarPath, Converter={StaticResource AvatarConverter}}"/>
                </Grid>
                <TextBlock Text="{Binding PeerAlias}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" Margin="0,14,0,5"/>
                <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsIncoming}" Value="True"><Setter Property="FontSize" Value="16"/></DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Ended"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                        </Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <Button x:Name="MinimizeButton" Content="{StaticResource MinimizeIcon}" Style="{StaticResource CallAction}" Width="48" Height="48" Padding="8" Background="Transparent"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" ToolTip="{DynamicResource UiMinimizeCall}"
                    AutomationProperties.Name="{DynamicResource UiMinimizeCall}" Foreground="{StaticResource TextBrush}" Click="Minimize_Click"/>
            <StackPanel x:Name="Quality" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16">
                <Ellipse Width="8" Height="8" Fill="{Binding QualityBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding RttText}" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="4,0,0,0"/>
            </StackPanel>
            <UniformGrid x:Name="IncomingActions" Rows="1" Columns="2" VerticalAlignment="Bottom" Margin="0,0,0,28" MaxWidth="420">
                <StackPanel HorizontalAlignment="Center"><Button x:Name="RejectButton" Style="{StaticResource CallTerminal}" Width="64" Height="64" Padding="16"
                    ToolTip="{DynamicResource UiRejectCall}" AutomationProperties.Name="{DynamicResource UiRejectCall}" Click="Reject_Click"/>
                    <TextBlock Text="{DynamicResource UiRejectCall}" FontSize="16" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
                <StackPanel HorizontalAlignment="Center"><Button Style="{StaticResource CallAnswer}" Width="64" Height="64" Padding="16"
                    ToolTip="{DynamicResource UiAcceptCall}" AutomationProperties.Name="{DynamicResource UiAcceptCall}" Click="Accept_Click"/>
                    <TextBlock Text="{DynamicResource UiAcceptCall}" FontSize="16" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
            </UniformGrid>
            <StackPanel x:Name="ActiveActions" VerticalAlignment="Bottom" Margin="0,0,0,28" MaxWidth="420">
                <UniformGrid Rows="1" Columns="3"><Button Style="{StaticResource CallMute}" HorizontalAlignment="Center" Click="Mute_Click"/>
                    <Button Style="{StaticResource CallOutputShortcut}" HorizontalAlignment="Center" Click="OutputRole_Click"/>
                    <Button Content="{StaticResource AudioDevicesIcon}" Style="{StaticResource CallAction}" HorizontalAlignment="Center"
                            IsEnabled="{Binding CanChooseAudioDevices}" ToolTip="{DynamicResource UiCallAudioDevices}"
                            AutomationProperties.Name="{DynamicResource UiCallAudioDevices}" Click="AudioDevices_Click"/>
                </UniformGrid>
                <Button x:Name="VoiceEndButton" Style="{StaticResource CallTerminal}" Width="60" Height="60" Padding="16"
                        HorizontalAlignment="Center" Margin="0,22,0,0"
                        ToolTip="{DynamicResource UiEndCall}" AutomationProperties.Name="{DynamicResource UiEndCall}" Click="End_Click"/>
            </StackPanel>
            <StackPanel x:Name="VideoActions" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,14" Visibility="Collapsed">
                <Button Style="{StaticResource CallMute}" Width="46" Height="46" Padding="9" Margin="3" Click="Mute_Click"/>
                <Button Style="{StaticResource CallOutputShortcut}" Width="46" Height="46" Padding="9" Margin="3" Click="OutputRole_Click"/>
                <Button Content="{StaticResource AudioDevicesIcon}" Style="{StaticResource CallAction}" Width="46" Height="46" Padding="9" Margin="3"
                        IsEnabled="{Binding CanChooseAudioDevices}" ToolTip="{DynamicResource UiCallAudioDevices}"
                        AutomationProperties.Name="{DynamicResource UiCallAudioDevices}" Click="AudioDevices_Click"/>
                <Button Style="{StaticResource CallCamera}" Width="46" Height="46" Padding="9" Margin="3"
                        IsEnabled="{Binding CanControlCamera}" Click="Camera_Click"/>
                <Button Content="{StaticResource SwitchCameraIcon}" Style="{StaticResource CallAction}" Width="46" Height="46" Padding="9"
                        Margin="3" IsEnabled="{Binding CanSwitchCamera}" ToolTip="{DynamicResource UiCallSwitchCamera}"
                        AutomationProperties.Name="{DynamicResource UiCallSwitchCamera}" Click="SwitchCamera_Click"/>
                <Button Style="{StaticResource CallTerminal}" Width="46" Height="46" Padding="9"
                        Margin="3" ToolTip="{DynamicResource UiEndCall}" AutomationProperties.Name="{DynamicResource UiEndCall}" Click="End_Click"/>
            </StackPanel>
        </Grid>
        <Button x:Name="CompactPanel" Visibility="Collapsed" Width="158" Height="70" Background="{DynamicResource MessagingChromeBrush}"
                HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5"
                ToolTip="{DynamicResource UiRestoreCall}" AutomationProperties.Name="{DynamicResource UiRestoreCall}"
                AutomationProperties.HelpText="{Binding PeerAlias}" AutomationProperties.ItemStatus="{Binding CompactStatusText}"
                PreviewMouseLeftButtonDown="Compact_MouseLeftButtonDown" PreviewMouseMove="Compact_MouseMove"
                PreviewMouseLeftButtonUp="Compact_MouseLeftButtonUp" LostMouseCapture="Compact_LostMouseCapture" Click="Compact_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CompactChrome" Background="{TemplateBinding Background}" CornerRadius="14" BorderThickness="1"
                            BorderBrush="{DynamicResource MessagingDividerBrush}" Padding="9,6">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CompactChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Button.RenderTransform><TranslateTransform x:Name="CompactPosition"/></Button.RenderTransform>
            <DockPanel VerticalAlignment="Center">
                <Grid DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,8,0">
                    <Ellipse Fill="{DynamicResource MessagingSelectionBrush}"/>
                    <TextBlock Text="{Binding PeerInitial}" FontSize="16" Foreground="{DynamicResource MessagingSelectionMarkBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse Fill="{Binding PeerAvatarPath, Converter={StaticResource AvatarConverter}}"/></Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PeerAlias}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                    <DockPanel Margin="0,3,0,0">
                    <Path DockPanel.Dock="Right" Data="{StaticResource MutedMicrophoneIcon}" Width="12" Height="12"
                          Stretch="Uniform" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" Margin="4,0,0,0">
                        <Path.Style><Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsMuted}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger></Style.Triggers>
                        </Style></Path.Style>
                    </Path>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </StackPanel>
                </DockPanel>
        </Button>
    </Grid>
</UserControl>
