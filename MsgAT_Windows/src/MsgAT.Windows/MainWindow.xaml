<Window x:Class="MsgAT.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:MsgAT.Windows.Infrastructure"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MsgAT" Width="1040" Height="680" MinWidth="820" MinHeight="540"
        Style="{StaticResource AppWindowStyle}" Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed"
        Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="16,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MsgAT" FontSize="22" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Grid Width="12" Height="12" Margin="0,0,6,0">
                            <Ellipse Width="10" Height="10">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="Red" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SyncText}" Value="Connected">
                                                <Setter Property="Fill" Value="Lime" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SyncText}" Value="Syncing...">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Path Data="M 6,1 A 5,5 0 1 1 1,6" Stroke="Lime" StrokeThickness="2" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SyncText}" Value="Syncing...">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Name="SyncAnimation">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="SyncAnimation" /></DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                        <TextBlock Text="{Binding SyncText, FallbackValue=Disconnected}" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="Red" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SyncText}" Value="Connected"><Setter Property="Foreground" Value="Lime" /></DataTrigger>
                                        <DataTrigger Binding="{Binding SyncText}" Value="Syncing..."><Setter Property="Foreground" Value="Lime" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" ToolTip="Menu" AutomationProperties.Name="Menu" Click="MainMenu_Click">
                        <Button.Content><Geometry>M 12,4 L 12,20 M 4,12 L 20,12</Geometry></Button.Content>
                    </Button>
                </Grid>

                <ListBox x:Name="ConversationList" Grid.Row="1" ItemsSource="{Binding Conversations}"
                         SelectedItem="{Binding SelectedConversation}" Background="Transparent"
                         BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ConversationItemStyle}">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="Conversation_PreviewMouseRightButtonDown" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="50">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="20" Background="#FF314050"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" />
                                        <Ellipse Fill="{Binding AvatarPath, Converter={StaticResource AvatarConverter}}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,7,0">
                                    <TextBlock Text="{Binding Alias}" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Uuid}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border x:Name="Unread" Grid.Column="2" Background="#FFFF5C69" CornerRadius="9"
                                        MinWidth="18" Height="18" Padding="5,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UnreadCount}" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding UnreadCount}" Value="0">
                                    <Setter TargetName="Unread" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource WindowBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="20,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedConversation.Alias}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedConversation.Uuid}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <ListBox x:Name="MessageList" Grid.Row="1" ItemsSource="{Binding Messages}"
                     Background="{StaticResource WindowBrush}" BorderThickness="0" Padding="20,14"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     PreviewMouseWheel="MessageList_PreviewMouseWheel"
                     ScrollViewer.ScrollChanged="MessageList_ScrollChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="PreviewMouseRightButtonDown"
                                     Handler="Message_PreviewMouseRightButtonDown" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Border x:Name="Bubble" HorizontalAlignment="Left" MaxWidth="540"
                                    Padding="12,9" CornerRadius="12" Background="{StaticResource SurfaceBrush}">
                                <StackPanel>
                                    <Border x:Name="ReplyPreview" BorderBrush="#9954D6B0"
                                            BorderThickness="2,0,0,0" Padding="8,2" Margin="0,0,0,6" MouseLeftButtonDown="ReplyPreview_Click" Cursor="Hand">
                                        <TextBlock Text="{Binding ReplyPreview}" Foreground="#FFC7D0DB"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <infra:AttachmentPreview x:Name="Attachment" Message="{Binding}" Visibility="Collapsed" HorizontalAlignment="Left"
                                                             MouseLeftButtonUp="AttachmentPreview_Click" Cursor="Hand" />
                                    <DockPanel x:Name="TextContent">
                                        <Button x:Name="ReEditButton" DockPanel.Dock="Right" Visibility="Collapsed"
                                                Content="{StaticResource ReEditIcon}" ToolTip="Re-edit" AutomationProperties.Name="Re-edit"
                                                Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Margin="8,0,0,0"
                                                Click="ReEdit_Click" />
                                        <TextBlock x:Name="MessageContent" Text="{Binding DisplayContent}"
                                                   TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding TimeText}" Foreground="#FF96A3B4" FontSize="10" />
                                        <TextBlock Text="{Binding EditedText}" Foreground="#FF96A3B4" FontSize="10" />
                                        <TextBlock x:Name="DeliveryStatus" Text="{Binding StatusText}" Foreground="#FF96A3B4"
                                                   FontSize="10" Margin="6,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsAttachment}" Value="True">
                                <Setter TargetName="Attachment" Property="Visibility" Value="Visible" />
                                <Setter TargetName="TextContent" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDelivered}" Value="True">
                                <Setter TargetName="DeliveryStatus" Property="Foreground" Value="#FF54D6B0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="Bubble" Property="BorderBrush" Value="#FFE2C663" />
                                <Setter TargetName="Bubble" Property="BorderThickness" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ReplyPreview}" Value="">
                                <Setter TargetName="ReplyPreview" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMine}" Value="True">
                                <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Bubble" Property="Background" Value="#FF176A58" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAttachment}" Value="True">
                                <Setter TargetName="Bubble" Property="Background" Value="Transparent" />
                                <Setter TargetName="Bubble" Property="Padding" Value="0" />
                                <Setter TargetName="Bubble" Property="CornerRadius" Value="0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CanReEdit}" Value="True">
                                <Setter TargetName="ReEditButton" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRevoked}" Value="True">
                                <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Center" />
                                <Setter TargetName="Bubble" Property="Background" Value="Transparent" />
                                <Setter TargetName="MessageContent" Property="Foreground" Value="{StaticResource MutedBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ReplyBar" Grid.Row="0" Grid.ColumnSpan="3"
                            Background="#FF151F28" BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="3,0,0,0" CornerRadius="5" Padding="9,5"
                            Margin="46,0,80,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasReplyTarget}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{StaticResource CloseIcon}" ToolTip="Cancel reply" AutomationProperties.Name="Cancel reply"
                                    Style="{StaticResource IconButtonStyle}" Width="24" Height="24" MinHeight="24"
                                    Click="CancelReply_Click" />
                            <TextBlock Text="{Binding ReplyPreview}" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                    <Button x:Name="AttachmentButton" Grid.Row="1" Content="{StaticResource AttachIcon}"
                            ToolTip="Attachments" AutomationProperties.Name="Attachments"
                            Style="{StaticResource IconButtonStyle}" Width="42" Height="42"
                            IsEnabled="{Binding HasConversation}" Click="Attachment_Click" />
                    <TextBox x:Name="Composer" Grid.Row="1" Grid.Column="1"
                             Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                             Margin="10,0" MinHeight="42" MaxHeight="112" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             IsEnabled="{Binding HasConversation}"
                             PreviewKeyDown="Composer_PreviewKeyDown" />
                    <Button Grid.Row="1" Grid.Column="2" Content="{StaticResource SendIcon}" ToolTip="Send" AutomationProperties.Name="Send"
                            Width="42" Height="42" Style="{StaticResource PrimaryIconButtonStyle}"
                            IsEnabled="{Binding HasConversation}" Click="Send_Click" />
                </Grid>
            </Border>

            <wv2:WebView2 x:Name="WebRtcView" Width="1" Height="1"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
