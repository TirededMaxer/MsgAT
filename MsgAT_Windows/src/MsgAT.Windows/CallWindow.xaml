<Window x:Class="MsgAT.Windows.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice call" Width="420" Height="500" ResizeMode="NoResize"
        Style="{StaticResource AppWindowStyle}" Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Grid Background="{StaticResource WindowBrush}" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <StackPanel x:Name="FullPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Width="340">
            <Border Width="112" Height="112" CornerRadius="56" Background="#FF394150" HorizontalAlignment="Center">
                <Grid>
                    <TextBlock Text="{Binding PeerInitial}" FontSize="42" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Fill="{Binding PeerAvatarPath, Converter={StaticResource AvatarConverter}}" />
                </Grid>
            </Border>
            <TextBlock Text="{Binding PeerAlias}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"
                       MaxWidth="320" TextTrimming="CharacterEllipsis" ToolTip="{Binding PeerAlias}" Margin="0,22,0,6" />
            <TextBlock Text="{Binding StatusText}" FontSize="17" Foreground="#FFC5CBD4" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding RttText}" FontSize="12" Foreground="#FF8F98A6" HorizontalAlignment="Center" Margin="0,7,0,30" />
            <StackPanel x:Name="IncomingActions" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="{StaticResource HangUpIcon}" ToolTip="Reject" AutomationProperties.Name="Reject"
                        Style="{StaticResource DangerIconButtonStyle}" Width="44" Height="44" Margin="8" Click="Reject_Click" />
                <Button Content="{StaticResource CallIcon}" ToolTip="Accept" AutomationProperties.Name="Accept"
                        Style="{StaticResource PrimaryIconButtonStyle}" Width="44" Height="44" Margin="8" Click="Accept_Click" />
            </StackPanel>
            <StackPanel x:Name="ActiveActions" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource MicrophoneButtonStyle}" Width="44" Height="44" Margin="6" Click="Mute_Click" />
                <Button Content="{StaticResource HangUpIcon}" ToolTip="End" AutomationProperties.Name="End"
                        Style="{StaticResource DangerIconButtonStyle}" Width="44" Height="44" Margin="6" Click="End_Click" />
                <Button Content="{StaticResource MinimizeIcon}" ToolTip="Minimize" AutomationProperties.Name="Minimize"
                        Style="{StaticResource IconButtonStyle}" Width="44" Height="44" Margin="6" Click="Minimize_Click" />
            </StackPanel>
        </StackPanel>
        <StackPanel x:Name="CompactPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource MicrophoneButtonStyle}" Width="32" Height="32" MinHeight="32" Click="Mute_Click" />
                <Button Content="{StaticResource HangUpIcon}" ToolTip="End" AutomationProperties.Name="End"
                        Style="{StaticResource DangerIconButtonStyle}" Width="32" Height="32" MinHeight="32" Margin="6,0" Click="End_Click" />
                <Button Content="{StaticResource RestoreIcon}" ToolTip="Restore" AutomationProperties.Name="Restore"
                        Style="{StaticResource IconButtonStyle}" Width="32" Height="32" MinHeight="32" Click="Minimize_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
