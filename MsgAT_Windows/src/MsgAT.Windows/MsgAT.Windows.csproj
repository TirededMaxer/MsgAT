<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>MsgAT</AssemblyName>
    <RootNamespace>MsgAT.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishReadyToRun>false</PublishReadyToRun>
    <AllowedReferenceRelatedFileExtensions>.pri;.dll.config;.exe.config</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MsgAT.Windows.Core\MsgAT.Windows.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="ZXing.Net" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\NativeSecurity\win-x64\msgat_security_core.dll" Link="msgat_security_core.dll"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\webrtc-host.html" LogicalName="MsgAT.Windows.Assets.webrtc-host.html" />
    <EmbeddedResource Include="../../../shared/licenses/Apache-2.0.txt" LogicalName="MsgAT.Licenses.Apache-2.0.txt" />
    <EmbeddedResource Include="../../../shared/licenses/ZXing-NOTICE.txt" LogicalName="MsgAT.Licenses.ZXing-NOTICE.txt" />
    <EmbeddedResource Include="Assets\Licenses\SkiaSharp-LICENSE.txt" />
    <EmbeddedResource Include="Assets\Licenses\SkiaSharp-THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
</Project>
